# CAVACH — copy to .env (frontend) / .env.local (never commit real values).
# Frontend (Vite, build-time only):
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Edge Functions (Supabase secrets, server-side only — never in frontend):
# ALLOWED_ORIGIN=https://your-app-domain
# LLM_API_KEY= (provider key, server only)
# LLM_API_URL= / LLM_MODEL=
# SAFE_BROWSING_API_KEY= (Google Safe Browsing, non-commercial terms — check before use)
# EMBEDDING_API_URL= / EMBEDDING_API_KEY= / EMBEDDING_MODEL=multilingual-e5-large
# n8n (environment, never in workflow JSON):
# SUPABASE_URL= / SUPABASE_ANON_KEY= / SUPABASE_SERVICE_ROLE_KEY=
