      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{JSON.stringify({band: $json.band, score: $json.score, findings: $json.findings, needs_review: $json.needs_review})}}"
      },
      "id": "r1",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.2,
      "position": [
