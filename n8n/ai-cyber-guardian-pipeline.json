{
  "name": "CAVACH Investigate (fixed)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "cavach-investigate",
        "responseMode": "responseNode",
        "authentication": "headerAuth",
        "options": {},
        "credentials": {
          "httpHeaderAuth": {
            "name": "CAVACH Webhook Auth",
            "value": ""
          }
        }
      },
      "id": "w1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const t = $json.text || ''; if (!t.trim()) throw new Error('empty submission');\nconst redacted = t.replace(/(otp|pin|password)([^\\d]{0,20})(\\d{4,8})/gi, '$1$2[REDACTED]');\nreturn [{json: {...$json, text_redacted: redacted, text: t}}];"
      },
      "id": "c1",
      "name": "Validate + Redact",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst hash = crypto.createHash('sha256').update($json.text_redacted).digest('hex');\nreturn [{json: {...$json, content_hash: hash}}];"
      },
      "id": "c2",
      "name": "Dedupe (SHA-256)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.SUPABASE_URL}}/rest/v1/workflow_runs?content_hash=eq.{{$json.content_hash}}&select=id",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{$env.SUPABASE_ANON_KEY}}"
            }
          ]
        },
        "options": {
          "timeout": 10000
        }
      },
      "id": "h1",
      "name": "Check duplicate (Supabase REST)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        900,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true
          },
          "conditions": [
            {
              "leftValue": "={{$json.length}}",
              "rightValue": 0,
              "operation": {
                "type": "number",
                "operation": "larger"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if1",
      "name": "Is duplicate?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1120,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "\n// CAVACH Detect \u2014 full signal table (mirrors backend/engine.py v2).\n// Token-boundary matching; unique-signal scoring; bands, not probabilities.\n// Credential digits are redacted before anything is saved or returned.\nconst text = ($json.text || \"\");\nconst skeleton = text; // homoglyph normalisation for narrative is done in the Python engine; this node flags URL punycode below.\nconst lower = text.toLowerCase();\nfunction has(p){ return lower.includes(p); }\nconst S = [\n  [\"authority_impersonation\",30,[\"police\",\"court\",\"supreme court\",\"cbi\",\"\u092a\u094b\u0932\u0940\u0938\",\"\u092a\u0941\u0932\u093f\u0938\"]],\n  [\"threat_coercion\",25,[\"arrest\",\"legal action\",\"account will be blocked\",\"will be blocked\",\"\u0905\u091f\u0915\",\"\u0917\u093f\u0930\u092b\u094d\u0924\u093e\u0930\",\"\u092c\u0902\u0926 \u0939\u094b\u0908\u0932\"]],\n  [\"urgency\",15,[\"urgent\",\"urgently\",\"immediately\",\"\u0924\u093e\u0924\u094d\u0915\u093e\u0933\",\"\u0932\u0917\u0947\u091a\",\"\u0924\u0941\u0930\u0902\u0924\"]],\n  [\"secrecy\",20,[\"don't tell anyone\",\"do not tell\",\"\u0915\u094b\u0923\u093e\u0932\u093e \u0938\u093e\u0902\u0917\u0942 \u0928\u0915\u093e\",\"\u0915\u094b\u0923\u093e\u0932\u093e \u0938\u093e\u0902\u0917\u0942 \u0928\u0915\u094b\u0938\",\"\u0915\u093f\u0938\u0940 \u0915\u094b \u092e\u0924 \u092c\u0924\u093e\u0928\u093e\",\"konala sangu nakos\"]],\n  [\"credential_request\",30,[\"otp\",\"cvv\",\"share your otp\",\"\u0913\u091f\u0940\u092a\u0940\",\"\u092a\u093e\u0938\u0935\u0930\u094d\u0921\"]],\n  [\"payment_request\",20,[\"send money\",\"pay now\",\"pay rs\",\"\u092a\u0948\u0938\u0947 \u092a\u093e\u0920\u0935\",\"\u0930\u0941\u092a\u092f\u0947 \u092a\u093e\u0920\u0935\",\"\u092a\u0948\u0938\u0947 \u092d\u0947\u091c\u094b\",\"\u0930\u0941\u092a\u092f\u0947 \u092d\u0947\u091c\u094b\",\"paise pathav\",\"rupaye bhejo\",\"\u0930\u0941\u092a\u092f\u0947 \u092d\u0930\u093e\",\"registration fee\"]],\n  [\"new_number_story\",20,[\"new number\",\"\u0928\u092f\u093e \u0928\u0902\u092c\u0930\",\"\u0928\u0935\u0940\u0928 \u0928\u0902\u092c\u0930\",\"\u092e\u093e\u091d\u093e \u0928\u0935\u0940\u0928 \u0928\u0902\u092c\u0930\",\"my new number\"]],\n  [\"reward_bait\",20,[\"you won\",\"congratulations\",\"processing fee\",\"prize\",\"\u092c\u0927\u093e\u0908 \u0939\u094b\",\"\u0905\u092d\u093f\u0928\u0902\u0926\u0928\",\"redeem now\"]],\n  [\"kyc_request\",20,[\"kyc expired\",\"kyc \u0938\u092e\u093e\u092a\u094d\u0924\",\"kyc \u0938\u0902\u092a\u0932\u0947\",\"update kyc\",\"kyc update\"]],\n  [\"apk_install\",25,[\".apk\",\"install this app\",\"download apk\"]],\n];\nconst genuine = has(\"otp\") && (has(\"do not share\") || has(\"never share\") || has(\"\u0938\u093e\u091d\u093e \u0928 \u0915\u0930\u0947\u0902\")) && !has(\"send otp\");\nconst findings = []; const seen = new Set();\nfor (const [sig,w,pats] of S){\n  if (sig === \"credential_request\" && genuine) continue;\n  if (pats.some(has) && !seen.has(sig)){ seen.add(sig); findings.push({signal: sig, weight: w}); }\n}\n// URL signals\nconst urls = text.match(/https?:\\/\\/[^\\s<>\\\"']+/gi) || [];\nfor (const u of urls){\n  let host = \"\"; try { host = new URL(u).hostname.toLowerCase(); } catch(e) {}\n  if (host.includes(\"xn--\")) findings.push({signal: \"punycode_domain\", weight: 15});\n  if (/\\.(xyz|top|click|buzz|site|online)$/.test(host)) findings.push({signal: \"suspicious_tld\", weight: 10});\n  if ([\"bit.ly\",\"tinyurl.com\",\"t.co\"].includes(host)) findings.push({signal: \"shortener\", weight: 10});\n  if (/^\\d+\\.\\d+\\.\\d+\\.\\d+$/.test(host)) findings.push({signal: \"bare_ip\", weight: 15});\n}\nconst score = findings.reduce((a,f)=>a+f.weight,0);\nconst band = score >= 50 ? \"High concern\" : score >= 15 ? \"Suspicious\" : text.length >= 40 ? \"Low concern\" : \"Insufficient evidence\";\nreturn [{json: {...$json, findings, score, band, needs_review: band === \"High concern\"}}];\n"
      },
      "id": "c3",
      "name": "Detect (full rules)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        1120,
        500
      ]
    },
