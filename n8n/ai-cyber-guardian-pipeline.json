        "responseBody": "={\"duplicate\": true, \"detail\": \"This submission was already processed.\"}"
      },
      "id": "r2",
      "name": "Respond duplicate",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.2,
      "position": [
        1340,
